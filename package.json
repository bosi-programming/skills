    ".claude-plugin",
    ".codex-plugin",
    "dsh",
    "opencode",
    "skills"
  ],
  "keywords": [
    "coding-agent",
    "skills",
    "code-review",
    "code-standards",
    "pi-package"
  ],
  "pi": {
